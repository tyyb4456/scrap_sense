ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://scrapsense:scrapsense@localhost:5432/scrapsense
DATABASE_ECHO=false

XKIRO_MODEL=mistralai/mistral-large-2512
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=

# Anomaly detection (conservative defaults, not validated thresholds)
# Tier 3 is only called for statistically suspicious reports when this is true.
USE_LLM_REASONING=false
ANOMALY_LLM_TIMEOUT_SECONDS=15
ANOMALY_MIN_SAMPLE_SIZE=5
ANOMALY_MAX_OBSERVATION_AGE_DAYS=90
ANOMALY_MAX_COMPARISONS=500
ANOMALY_MAD_Z_THRESHOLD=3.5
ANOMALY_MIN_RELATIVE_DEVIATION=0.5
ANOMALY_ZERO_MAD_MIN_RELATIVE_DEVIATION=1.0
# Tier 2 stays disabled until a trained artifact and sufficient real data exist.
ANOMALY_ML_ENABLED=false
ANOMALY_ML_MIN_REPORTS=200
ANOMALY_ML_ARTIFACT_PATH=app/ml_artifacts/isolation_forest.joblib

# Price intelligence (conservative defaults, not validated thresholds)
PRICE_MIN_OBSERVATIONS=3
PRICE_MAX_OBSERVATION_AGE_DAYS=90
PRICE_MAX_OBSERVATIONS=2000
PRICE_DUPLICATE_WINDOW_MINUTES=15
PRICE_SEED_PRICES_PATH=app/data/seed_prices.json

CORS_ORIGINS=["http://localhost:5173"]

CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]
ADMIN_USER_IDS=[]
